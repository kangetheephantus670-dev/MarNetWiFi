# Copy this file to .env and fill in real values.
# Never commit the real .env file — only .env.example belongs in git.

# --- Server ---
PORT=3000
# Long random string used to sign admin login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# Comma-separated list of the exact origins allowed to call this API.
# These are wherever you end up hosting marnet-portal.html and
# marnet-admin.html — captive portals are often served straight from the
# router itself, in which case that origin is the router's own IP/hostname.
ALLOWED_ORIGINS=https://portal.example.com,https://admin.example.com

# --- Supabase (Project Settings -> API) ---
# Use the SERVICE ROLE key here, never the anon/public key — this backend
# needs to read and write every table directly, bypassing row-level
# security, and that key must never reach either frontend file.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_KEY=YOUR_SERVICE_ROLE_KEY

# --- MikroTik (Winbox -> IP -> Services -> api, default port 8728) ---
# Create a dedicated API user on the router rather than reusing "admin" —
# it only needs the "api" and "hotspot" policy groups.
MIKROTIK_HOST=192.168.88.1
MIKROTIK_PORT=8728
MIKROTIK_USER=marnet-api
MIKROTIK_PASSWORD=change-me
# The RouterOS hotspot user "profile" to assign new users to, if you use
# one. Leave blank to use the hotspot server's default profile.
MIKROTIK_HOTSPOT_PROFILE=

# --- Safaricom Daraja (developer.safaricom.co.ke) ---
# "sandbox" for testing, "production" once you have a live shortcode.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
# 174379 is Safaricom's shared sandbox till — replace with your real
# paybill/till once you move to production.
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
# Must be a public HTTPS URL Safaricom can reach — e.g. your Render URL.
MPESA_CALLBACK_URL=https://your-backend.onrender.com/api/mpesa/callback

# --- Safaricom Daraja — C2B ("paste your M-Pesa code" flow) ---
# Only needed once you have a Till and want clients to be able to pay it
# directly (outside the app) and then paste the resulting M-Pesa code on
# the portal. Register these once via POST /api/admin/mpesa/register-c2b
# (operator login required) after filling them in here and deploying.
MPESA_C2B_CONFIRMATION_URL=https://your-backend.onrender.com/api/mpesa/c2b/confirmation
MPESA_C2B_VALIDATION_URL=https://your-backend.onrender.com/api/mpesa/c2b/validation

# --- Policy defaults ---
# Applied to every plan/customer unless a plan row overrides it.
DEFAULT_SPEED_MBPS=3
# How often (ms) the backend polls MikroTik for live data usage per
# device. Set to 0 to disable.
USAGE_SYNC_INTERVAL_MS=300000
